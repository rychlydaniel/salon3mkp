<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Salon 3MKP</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    {% set sectionColors = colors[section] %}
    {% if sectionColors %}
    <style>
        :root {
            --primary-color: {{ sectionColors.primary }};
            --secondary-color: {{ sectionColors.secondary }};
        }
        {% if sectionColors.bgType == "image" and sectionColors.bgImage %}
        body {
            background-image: url('{{ sectionColors.bgImage }}');
            background-size: cover;
            background-attachment: fixed;
            background-position: center top;
        }
        {% endif %}
    </style>
    {% endif %}
</head>
<body>
    <div class="header-bg"></div>

    {% set sec = sections[section] %}
    <nav class="top-nav">
        <div class="nav-container">
            <div class="logo-section">
                <div>
                    <a href="/{{ section }}/" class="brand-name">3MKP</a>
                    <div class="brand-subtitle">{{ sec.subtitle }}</div>
                </div>
            </div>
            <ul class="main-menu">
                {% for link in sec.topNav %}
                <li><a href="{{ link.url }}">{{ link.label }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </nav>

    <nav class="secondary-nav">
        <ul class="secondary-menu">
            {% set sectionPages = collections[section] %}
            {% for item in sectionPages %}
            <li><a href="{{ item.url }}"{% if item.url == page.url %} class="active"{% endif %}>{{ item.data.navLabel }}</a></li>
            {% endfor %}
        </ul>
    </nav>

    <main class="container">
        {% if pageType == "home" %}
            <h1>{{ title }}</h1>
            {{ content | safe }}

        {% elif pageType == "contact" %}
            <h2>{{ title }}</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; margin: 40px 0;">
                <div class="contact-info">
                    <h3>Navštivte nás</h3>
                    <p>{{ address }}<br>{{ zip }}</p>
                    {% if ico %}<p>IČO: {{ ico }}</p>{% endif %}
                    <p>Tel: {{ phone }}</p>
                </div>
                <div class="contact-info">
                    <h3>Otevírací doba</h3>
                    <p>{{ hours | safe }}</p>
                </div>
                <div class="contact-info">
                    <h3>Webové stránky</h3>
                    {% if facebook %}<p>Facebook: {{ facebook }}</p>{% endif %}
                    {% if instagram %}<p>Instagram: {{ instagram }}</p>{% endif %}
                </div>
            </div>
            {% if mapUrl %}
            <div class="map-container">
                <iframe style="border:none" src="{{ mapUrl }}" width="100%" height="400" frameborder="0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allow="geolocation"></iframe>
            </div>
            {% endif %}

        {% else %}
            <h2>{{ title }}</h2>

            {% if image and imagePosition == "top" %}
                <div class="text-center">
                    <img src="{{ image }}" alt="{{ imageAlt }}" style="max-width: 900px; width: 100%; height: auto; border-radius: 8px;">
                </div>
                <div style="max-width: 800px; margin: 0 auto;">
                    {{ content | safe }}
                </div>
            {% elif image %}
                <div style="display: flex; gap: 40px; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 300px;">
                        {{ content | safe }}
                    </div>
                    <div style="flex: 0 0 auto;">
                        <img src="{{ image }}" alt="{{ imageAlt }}" class="content-image">
                    </div>
                </div>
            {% else %}
                {{ content | safe }}
            {% endif %}

            {% if pricing and pricing.length %}
            <table class="pricing-table">
                <thead><tr><th>Služba</th><th>Délka</th><th>Cena</th></tr></thead>
                <tbody>
                    {% for item in pricing %}
                    <tr>
                        <td>{{ item.service }}</td>
                        <td>{{ item.duration }}</td>
                        <td>{{ item.price }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}

            {% if faq and faq.length %}
            <h3 class="mt-40">Časté otázky</h3>
            {% for item in faq %}
            <div class="faq-item">
                <h3>{{ item.question }}</h3>
                <p>{{ item.answer }}</p>
            </div>
            {% endfor %}
            {% endif %}
        {% endif %}
    </main>

    <footer>
        <p>&copy; 2035 by Soft Aesthetics</p>
        <div class="social-links">
            <a href="https://www.facebook.com/" target="_blank">Facebook</a>
            <a href="https://twitter.com/" target="_blank">Twitter</a>
        </div>
    </footer>
</body>
</html>
